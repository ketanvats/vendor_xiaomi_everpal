#
# Xiaomi HyperOS Core Init Configuration for Xiaomi Everpal (MT6833)
# Android 17 / HyperOS 4 Compatibility
#

on early-init
    # MediaTek & Xiaomi Touch dev nodes
    mkdir /dev/bus 0755 root root
    mkdir /dev/bus/input 0755 root root

on init
    # Xiaomi touchfeature interface
    chmod 0660 /dev/xiaomi-touch
    chown system system /dev/xiaomi-touch
    chmod 0660 /dev/touchfeature
    chown system system /dev/touchfeature

    # Xiaomi Performance nodes
    chmod 0664 /dev/xiaomi-perf
    chown system system /dev/xiaomi-perf

on boot
    # Touch screen tuning nodes
    chown system system /sys/class/touch/touch_dev/palm_sensor
    chmod 0664 /sys/class/touch/touch_dev/palm_sensor
    chown system system /sys/class/touch/touch_dev/game_mode
    chmod 0664 /sys/class/touch/touch_dev/game_mode
    chown system system /sys/class/touch/touch_dev/touch_active_status
    chmod 0664 /sys/class/touch/touch_dev/touch_active_status

    # Xiaomi Display feature / color tuning nodes
    chown system graphics /sys/class/drm/card0-DSI-1/disp_param
    chmod 0664 /sys/class/drm/card0-DSI-1/disp_param
    chown system graphics /sys/class/drm/card0-DSI-1/doze_brightness
    chmod 0664 /sys/class/drm/card0-DSI-1/doze_brightness

    # Thermal & MiPerf message interface
    chown system system /sys/class/thermal/thermal_message/sconfig
    chmod 0660 /sys/class/thermal/thermal_message/sconfig
    chown system system /sys/class/thermal/thermal_message/balance_mode
    chmod 0660 /sys/class/thermal/thermal_message/balance_mode
    chown system system /sys/class/thermal/thermal_message/charger_temp
    chmod 0440 /sys/class/thermal/thermal_message/charger_temp

    # Battery & Charging
    chown system system /sys/class/power_supply/battery/input_suspend
    chmod 0660 /sys/class/power_supply/battery/input_suspend

    # HyperOS 4 / Android 17 memory & ZRAM optimizations
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/watermark_boost_factor 0
    write /proc/sys/vm/watermark_scale_factor 125
    write /sys/block/zram0/comp_algorithm lz4

on property:sys.boot_completed=1
    # Enable Xiaomi thermal daemon optimizations
    setprop persist.vendor.thermal.config /vendor/etc/thermal/thermal_hyperos.conf
    # Display default color profile
    write /sys/class/drm/card0-DSI-1/disp_param 0x0
