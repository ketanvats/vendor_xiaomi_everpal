type hal_citsensorservice_xiaomi_default, domain;
type hal_citsensorservice_xiaomi_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_citsensorservice_xiaomi_default)

add_hwservice(hal_citsensorservice_xiaomi_default, hal_citsensorservice_xiaomi_hwservice)
add_service(hal_citsensorservice_xiaomi_default, hal_citsensorservice_xiaomi_service)

allow hal_citsensorservice_xiaomi_default system_server:binder call;
allow system_server hal_citsensorservice_xiaomi_default:binder { call transfer };
