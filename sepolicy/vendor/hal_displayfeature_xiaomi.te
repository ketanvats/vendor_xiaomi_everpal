type hal_displayfeature_xiaomi_default, domain;
type hal_displayfeature_xiaomi_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_displayfeature_xiaomi_default)

add_hwservice(hal_displayfeature_xiaomi_default, hal_displayfeature_xiaomi_hwservice)
add_service(hal_displayfeature_xiaomi_default, hal_displayfeature_xiaomi_service)

allow hal_displayfeature_xiaomi_default sysfs_graphics:dir search;
allow hal_displayfeature_xiaomi_default sysfs_graphics:file rw_file_perms;
allow hal_displayfeature_xiaomi_default graphics_device:chr_file rw_file_perms;
allow hal_displayfeature_xiaomi_default system_server:binder call;
allow system_server hal_displayfeature_xiaomi_default:binder { call transfer };
